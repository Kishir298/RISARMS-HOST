[Unit]
Description=RISARMS rescs backend
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=risarms
Group=risarms
WorkingDirectory=/var/lib/risarms/rescs
EnvironmentFile=/etc/risarms/rescs.env
ExecStart=/opt/risarms/rescs-venv/bin/rescs serve --host 127.0.0.1 --port 8081
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/risarms/rescs
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
