[Unit]
Description=RISARMS core backend
After=network.target risarms-rescs.service
Wants=risarms-rescs.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=risarms
Group=risarms
WorkingDirectory=/var/lib/risarms/core
EnvironmentFile=/etc/risarms/core.env
ExecStart=/opt/risarms/core-venv/bin/core-host --gateway-only --no-browser
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
RuntimeDirectory=risarms-inference
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/risarms/core
ReadWritePaths=/run/risarms-inference
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
